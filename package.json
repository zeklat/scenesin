{
  "name": "scenesin",
  "version": "1.0.0",
  "description": "Create stunning motion graphic explainer videos from code, script, and prompt across 8 visual styles in 9:16 and 16:9 formats.",
  "type": "module",
  "bin": {
    "scenesin": "./bin/scenesin.mjs"
  },
  "main": "./bin/scenesin.mjs",
  "scripts": {
    "start": "node ./bin/scenesin.mjs",
    "create": "node ./bin/scenesin.mjs create",
    "test": "node ./bin/scenesin.mjs check"
  },
  "keywords": [
    "video-generation",
    "motion-graphics",
    "code-to-video",
    "explainer-videos",
    "kinetic-typography",
    "threejs",
    "canvas-animation",
    "shorts",
    "reels",
    "youtube",
    "antigravity",
    "claude-code",
    "cursor"
  ],
  "author": {
    "name": "Anouar Zeklat",
    "url": "https://www.youtube.com/@anouarzeklat"
  },
  "homepage": "https://github.com/zeklat/scenesin",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeklat/scenesin.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mojs/core": "^1.3.0",
    "animejs": "^4.5.0",
    "gsap": "^3.15.1",
    "roughjs": "^4.6.6",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  }
}
